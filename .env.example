# ==============================================================================
# Environment Configuration Template
# Real-Time Customer Churn Analytics
# ==============================================================================
# Instructions:
# 1. Copy this file to .env:
#    cp .env.example .env
# 2. Update the credentials below with your desired configuration.
# 3. Never commit .env to version control!
# ==============================================================================

# Name used as the prefix of Docker objects
COMPOSE_PROJECT_NAME=churn

# Database Configuration (MySQL 8.0)
DB_NAME=churn_db
DB_USER=churn_user
DB_PASSWORD=churn_password
DB_ROOT_PASSWORD=root_password
# Port on YOUR laptop. If you already run MySQL locally, use 3307.
DB_HOST_PORT=3306

# Apache NiFi Authentication (Single-User Credentials)
# Note: NIFI_PASSWORD must be at least 12 characters long
NIFI_USERNAME=admin_user_churn
NIFI_PASSWORD=churn_admin_pass123

# Grafana Dashboard Authentication
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin_password

# Spark worker resources (lower them if your laptop has less than 8 GB RAM)
SPARK_WORKER_MEMORY=2g
SPARK_WORKER_CORES=2
